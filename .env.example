# Copy to .env and adjust. Never commit real values.

# --- Mode ---
# true simulates the LLM (no API key needed); production uses false
DEMO=true
# true blocks all write actions, even with a valid admin token
BACKEND_DEMO_LOCKED=false

# --- Auth ---
# Required for admin routes and the operator console; admin routes refuse everything when unset
ADMIN_TOKEN=change-me-admin
# Bearer token for server-to-server /search calls; also signs chat-page sessions
SEARCH_API_TOKEN=change-me-search
# Base64 of 32 random bytes: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
PAYLOAD_ENCRYPTION_KEY=

# --- Gemini ---
# Google AI Studio key (required when DEMO=false)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MODEL_FALLBACK=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Max answer tokens and sampling temperature
MAX_TOKENS=2000
TEMPERATURE=0.1
# Characters of retrieved text sent to the model per question
MAX_CONTEXT_CHARS=6000

# --- Embeddings ---
# Gemini embeddings; the dimension must match the existing collection.
# With DEMO=true, deterministic local vectors are used instead.
EMBEDDING_PROVIDER=gemini
EMBEDDING_DIM=768
# Seconds before an embedding call is abandoned
EMBEDDING_TIMEOUT=30

# --- Vector store ---
# Local Qdrant directory (mount a persistent volume here in production)
QDRANT_PATH=./local_qdrant_db
# Optional remote Qdrant instead of the local directory
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=documents

# --- Usage history ---
# Optional Postgres; without it usage and conversations stay in memory
DATABASE_URL=

# --- Limits ---
# Requests per minute / per day per client IP
RATE_LIMIT_PER_MIN=10
RATE_LIMIT_PER_DAY=100
# Requests per chat session per day
RATE_LIMIT_PER_SESSION=20
# Total Gemini tokens allowed per day across all clients
DAILY_TOKEN_BUDGET=50000
# Upper bound for top_k on /search
MAX_SEARCH_LIMIT=15
# Largest accepted upload in bytes (25 MB)
MAX_UPLOAD_BYTES=26214400
# Comma-separated extra origins allowed to call the API from a browser (empty = same origin only)
CORS_ALLOW_ORIGINS=

# --- Runtime ---
# Also write logs to a file
LOG_TO_FILE=false
LOG_PATH=./backend/logs/app.log
PORT=8002
